# Скопіюйте в .env (він у .gitignore) і заповніть. Справжні значення — лише в налаштуваннях Render.
APP_ENV=local
# Рядок підключення з Neon (Connection string, прямий — без -pooler, для міграцій Alembic):
DATABASE_URL=
DIAG_ENABLED=true
COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:5173
# Секрет проксі Vercel (SQ-05); локально не потрібен — порожнє значення вимикає перевірку.
GEDH_PROXY_SECRET=
# Підпис токенів; локально можна не задавати (тоді тимчасовий ключ до перезапуску)
JWT_SECRET=
# Пароль демо-облікових записів *@demo.gedh.invalid (≥ 10 символів, літери й цифри)
DEMO_PASSWORD=
# Brevo: без ключа листи лише пишуться в журнал сервера
BREVO_API_KEY=
MAIL_FROM=
# Секрет службових задач (GitHub Actions → /api/internal/jobs/*)
JOB_TOKEN=
